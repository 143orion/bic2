   "notion": "4.6",
   "origine": "cours",
   "titre": "Parité sur un intervalle symétrique (notes du prof)",
   "enonce": "Le but : reconnaître une fonction impaire pour conclure sans calcul.\n\nCalculer $$I = \\int_{-1}^{1}\\frac{e^{x^2}\\sin x}{1 + x^2}\\,dx$$",
   "guidage": "1. Calculer $f(-x)$.\n2. Comparer à $f(x)$.\n3. Conclure avec la parité.",
   "duree": 3,
   "etapes": [
    {
     "consigne": "Remplace $x$ par $-x$ : $\\sin(-x) = -\\sin x$, $(-x)^2 = x^2$. Écris $f(-x)$ en fonction de $f(x)$.",
     "question": "$f(-x)$ = ? (en fonction de $f(x)$)",
     "verif": {
      "mode": "exact",
      "attendu": [
       "-f(x)",
       "−f(x)",
       "- f(x)"
      ]
     },
     "corrige": "$f(-x) = \\frac{e^{x^2}\\cdot(-\\sin x)}{1 + x^2} = -f(x)$ : $f$ est impaire.",
     "guideSeul": true
    },
    {
     "consigne": "Intervalle symétrique et $f$ impaire : conclus.",
     "question": "$I$ = ?",
     "verif": {
      "mode": "expr",
      "attendu": "0"
     },
     "corrige": "$f$ impaire sur $[-1, 1]$ : $\\boxed{I = 0}$.",
     "indices": [
      "$f(-x) = -f(x)$.",
      "Les aires de part et d'autre de $0$ se compensent."
     ],
     "duree": 1
    }
   ]
  },
