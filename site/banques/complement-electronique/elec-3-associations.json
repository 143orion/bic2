     "$1{,}5\\ \\text{A}$",
     "$3\\ \\text{A}$"
    ],
    "verif": {
     "attendu": [
      0
     ]
    },
    "explication": "$I_1 = 3 \\times \\frac{2}{3} = 2\\ \\text{A}$ : la plus petite résistance prend le plus de courant."
   }
  }
 ],
