   "id": "e3-102",
   "type": "exo",
   "titre": "TD2 · Exercice 2 — Deux générateurs en opposition",
   "notion": "Association de générateurs",
   "origine": "td",
   "enonce": "$D_1$ : $E_1 = 48\\ \\text{V}$, $r_1 = 1{,}5\\ \\Omega$ ; $D_2$ : $E_2 = 24\\ \\text{V}$, $r_2 = 0{,}5\\ \\Omega$, placés en série avec $R = 10\\ \\Omega$. D'après le fléchage, $D_2$ est monté **en opposition**.",
   "duree": 8,
   "etapes": [
    {
     "consigne": "Écris la loi des mailles et calcule l'intensité $I$ du courant.",
     "question": "$I = ?$",
     "verif": {
      "mode": "numerique",
      "attendu": 2,
      "unite": "A"
     },
     "indices": [
      "Les f.é.m. se retranchent : $E_1 - E_2$.",
      "$I = \\dfrac{E_1 - E_2}{r_1 + r_2 + R}$."
     ],
     "corrige": "$I = \\dfrac{48 - 24}{1{,}5 + 0{,}5 + 10} = \\mathbf{2\\ \\text{A}}$"
