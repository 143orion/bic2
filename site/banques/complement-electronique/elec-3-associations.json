     "consigne": "Tension $U_1$ aux bornes de $D_1$ (générateur).",
     "question": "$U_1 = ?$",
     "verif": {
      "mode": "numerique",
      "attendu": 45,
      "unite": "V"
     },
     "indices": [
      "Générateur : $U_1 = E_1 - r_1 I$."
     ],
     "corrige": "$U_1 = 48 - 1{,}5 \\times 2 = \\mathbf{45\\ \\text{V}}$",
     "schema": {
      "surligne": [
       "E1",
