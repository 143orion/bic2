     "verif": {
      "mode": "numerique",
      "attendu": 2000,
      "unite": "Ω"
     },
     "indices": [
      "$R_3 + R_4 = 2{,}5\\ \\text{k}\\Omega$, en parallèle avec $R_2 = 2{,}5\\ \\text{k}\\Omega$.",
      "$R_{eq} = R_1 + (R_2 \\parallel (R_3+R_4)) + R_5$."
     ],
     "corrige": "$R_2 \\parallel 2{,}5\\ \\text{k}\\Omega = 1{,}25\\ \\text{k}\\Omega$, $R_{eq} = 250 + 1250 + 500 = \\mathbf{2\\ \\text{k}\\Omega}$",
     "schema": {
