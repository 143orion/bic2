      "mode": "numerique",
      "attendu": 25,
      "unite": "V"
     },
     "indices": [
      "En récepteur : $U_2 = E_2 + r_2 I$."
     ],
     "corrige": "$U_2 = 24 + 0{,}5 \\times 2 = \\mathbf{25\\ \\text{V}}$",
     "schema": {
      "surligne": [
       "E2",
       "r2"
      ]
     }
    },
    {
     "consigne": "Tension $U$ aux bornes de $R$.",
